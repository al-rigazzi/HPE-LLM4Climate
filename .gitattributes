# Git LFS configuration for HPE-LLM4Climate
# Track all zarr datasets with Git LFS
*.zarr/** filter=lfs diff=lfs merge=lfs -text
data/**/*.zarr/** filter=lfs diff=lfs merge=lfs -text
# Track large binary files
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
# Track large data files
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.nc filter=lfs diff=lfs merge=lfs -text
*.grib filter=lfs diff=lfs merge=lfs -text
*.grib2 filter=lfs diff=lfs merge=lfs -text
data/real_ecmwf_latest.zarr/** filter=lfs diff=lfs merge=lfs -text
